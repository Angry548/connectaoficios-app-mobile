{
  "expo": {
    "name": "ConnectaOficios",
    "slug": "connectaoficios-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.remate827.connectaoficiosmobile"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ConnectaOficios necesita acceso a tus fotos para seleccionar tu fotografía de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "126f28fb-0c18-45da-8a2a-3e5de92525d9"
      }
    }
  }
}
